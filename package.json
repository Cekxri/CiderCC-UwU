{
  "name": "cidercc-uwu",
  "version": "1.1.0",
  "type": "module",
  "description": "A chill little relay that turns the Command Code API into OpenAI / Anthropic compatible endpoints ~ UwU",
  "license": "MIT",
  "main": "proxy.mjs",
  "scripts": {
    "start": "node proxy.mjs",
    "dev": "node --watch proxy.mjs",
    "docker:build": "docker build -t cidercc-uwu:latest .",
    "docker:build:multi": "docker buildx build --platform linux/amd64,linux/arm64 -t cidercc-uwu:latest ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "command-code",
    "proxy",
    "relay",
    "openai",
    "anthropic",
    "responses-api",
    "uwu"
  ]
}
